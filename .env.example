# Environment Variables Example for mysawit-harvest Service
# Copy this to .env and fill in actual values for development

# === Development Environment ===
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Development)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mysawit_harvest_db
SPRING_DATASOURCE_USERNAME=mysawit_harvest_user
SPRING_DATASOURCE_PASSWORD=mysawit_harvest_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# === Production Environment (Uncomment and Configure) ===
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://prod-db-host.example.com:5432/mysawit_harvest
# SPRING_DATASOURCE_USERNAME=mysawit_harvest_prod
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here
# JWT_SECRET=use-the-same-secret-as-auth-service
# STORAGE_DIR=/data/harvest/uploads
# HARVEST_PUBLIC_BASE_URL=https://your-harvest-app.fly.dev
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example,http://localhost:3000

# === Docker Compose Override ===
# These variables override docker-compose.yml settings if needed
# SPRING_DATASOURCE_URL=jdbc:postgresql://mysawit-harvest-db:5432/mysawit_harvest
# SPRING_DATASOURCE_USERNAME=mysawit_harvest_user
# SPRING_DATASOURCE_PASSWORD=mysawit_harvest_password

# === Application Configuration ===
# Logging level: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ID_AC_UI_CS_ADVPROG=DEBUG
